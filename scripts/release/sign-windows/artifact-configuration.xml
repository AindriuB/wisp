<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration reference. Create it in SignPath with the
     slug stored in SIGNPATH_ARTIFACT_CONFIGURATION_SLUG. The uploaded GitHub
     artifact is a zip holding wisp.exe at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="wisp.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
